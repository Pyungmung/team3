# [담당: 허겸/황진구] backend 환경변수 견본
# 실제 키가 들어간 .env는 절대 커밋하지 않습니다 (.gitignore에 이미 등록됨).
# 사용법: 이 파일을 복사해서 backend/.env로 저장한 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# backend/src/main/resources/application.yml이 spring.config.import로 이 파일을 자동으로 읽어옵니다.
#
# ⚠️ 중요: 안 쓸 값은 "키=" 형태로 빈 채 남겨두지 말고, 아래처럼 줄 자체를 주석(#) 처리하세요.
#    "키=빈값"으로 두면 application.yml의 ${키:기본값} 기본값이 적용되지 않고 "빈 문자열"이
#    그대로 쓰여서 JWT 서명 키 생성 실패, 네이버 로그인 기동 실패 같은 문제가 날 수 있습니다.

# --- MySQL (담당: 김시연 - DB 스키마 전체 관리) ---
# 기본(dev) 프로필은 H2 인메모리라 이 값들을 안 채워도 그냥 실행됩니다.
# 로컬에 설치된 MySQL이든 Aiven 같은 클라우드 MySQL이든, 값을 채운 뒤 local-mysql 프로필을 함께 켜면 붙습니다.
# (docs/DATABASE.md 참고 - "로컬 MySQL로 실행하기" 섹션에 실행 명령어까지 정리되어 있습니다)
DB_HOST=localhost
DB_USERNAME=root
# DB_PASSWORD=
# 클라우드 MySQL(Aiven 등)은 포트가 3306이 아닌 서비스별 임의 포트라 반드시 채워야 합니다
# (콘솔에서 확인 - 안 채우면 3306으로 시도하다 연결 타임아웃 납니다). 로컬 MySQL은 보통 안 채워도 됩니다.
# DB_PORT=
# 콘솔에 나온 기본 데이터베이스 이름이 "customhouse"가 아니면 채우세요 (예: Aiven 기본값 defaultdb).
# DB_NAME=

# --- JWT (담당: 허겸 - domain/user 인증/인가) ---
# JWT_SECRET=

# --- 네이버 OAuth2 로그인 (담당: 허겸) ---
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# --- 토스페이먼츠 (담당: 황진구 - domain/payment) ---
# 비워두면(=주석 처리) application.yml에 설정된 토스페이먼츠 공식 테스트(샌드박스) 키가 사용되어
# 별도 설정 없이도 바로 동작합니다. 운영 전환 시에만 개발자센터에서 발급받은 라이브 키로 채우세요.
# TOSS_SECRET_KEY=
# TOSS_CLIENT_KEY=

# --- AI 엔진(customhouse-ai) 주소 (기본값이 이미 application.yml에 있어 보통 생략 가능) ---
AI_ENGINE_BASE_URL=http://localhost:8000

# --- 이메일 발송: 고객센터 문의 + 회원가입/비밀번호 재설정 인증번호 (담당: 허겸) ---
# 채우지 않으면 서버는 정상 기동되지만, 발송 시점에 MAIL_SEND_FAILED가 납니다.
# 2026-09-30: Gmail SMTP는 Render 배포에서 연결 자체가 막혀(클라우드 호스팅의 흔한 스팸 방지
# 정책) SendGrid HTTP API로 교체했다 (global/mail/MailClient.java 참고).
# 1) https://sendgrid.com 가입 (무료: 하루 100통)
# 2) Settings > Sender Authentication > Single Sender Verification 에서 보낼 이메일 주소 하나를
#    인증한다 (도메인이 없어도 됨 - 그 주소로 온 확인 메일의 링크만 클릭하면 됨)
# 3) Settings > API Keys 에서 키 발급 (Mail Send 권한이면 충분)
# SENDGRID_API_KEY=
# 위 2번에서 인증한 그 이메일 주소와 정확히 같아야 한다 (다르면 SendGrid가 발송 자체를 거부함).
# SENDGRID_FROM_EMAIL=
# 문의 메일을 받을 주소. 비워두면 application.yml 기본값(rnltjd747@gmail.com)으로 발송됩니다.
# SUPPORT_RECEIVER_EMAIL=

# --- 관리자 계정 (담당: 송귀성 - 상단 "관리자 수정" 탭) ---
# 이 값을 채우고 서버를 켜면 admin@admin.com(ADMIN_EMAIL로 변경 가능) 관리자 계정이 만들어지거나 관리자로 승격되고,
# 이미 있던 계정이면 비밀번호도 이 값으로 바뀐다 (개발용 시드 DevAdminSeeder가 코드에 적힌 알려진 비밀번호로 미리 만든 계정이라서).
# 채우지 않으면 관리자 계정은 만들어지지 않는다(관리자 수정 탭 사용 불가). 절대 커밋/채팅에 적지 말 것.
# ADMIN_PASSWORD=
# ADMIN_EMAIL=
# 관리자 계정 이메일(admin@admin.com)은 로그인 아이디일 뿐 받을 수 있는 메일함이 아니다. 그 주소로 가는 메일(관심매물 알림 등)을
# 실제로 받을 이메일. 비워두면 바꾸지 않는다. 로그인 아이디/계정 이메일은 이 값과 무관하게 그대로다.
# ADMIN_MAIL_EMAIL=
