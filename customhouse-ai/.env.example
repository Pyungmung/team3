# [담당: 송귀성] customhouse-ai 환경변수 견본
# 실제 키가 들어간 .env는 절대 커밋하지 않습니다 (.gitignore에 이미 등록됨).
# 사용법: 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채워주세요.
#   cp .env.example .env
#
# 안 쓸 값은 "키=" 형태로 빈 채 두지 말고 줄 자체를 주석(#) 처리하세요 (backend/.env.example과 동일한 이유).

# --- 공공데이터포털 (국토교통부 전월세 실거래가: 아파트/오피스텔/연립다세대/단독다가구) ---
# 발급 방법: https://www.data.go.kr 회원가입 → "아파트 전월세 실거래가" 검색 →
#   "국토교통부_아파트 전월세 실거래가 자료" → 활용신청 (보통 자동/즉시 승인) →
#   마이페이지 > 개발계정 에서 "일반 인증키(Decoding)" 복사 (Encoding 키 말고 Decoding 키!)
# 채워두면 services/api_collector.py가 샘플 시세(regions.json) 대신 실거래가 평균으로 계산한다.
# 비워두면(=주석 처리) 지금처럼 샘플 데이터로 자동 폴백한다 (에러 없이 조용히 넘어감).
# MOLIT_API_KEY=

# --- 한국주택금융공사 (전세자금대출 금리 / 보증상품 추천) — 아직 미연동 ---
# HF_API_KEY=

# --- 한국부동산원 Open API — 아직 미연동 ---
# REB_API_KEY=

# --- SGIS 통계지리정보서비스 디벨로퍼 API — 아직 미연동 ---
# SGIS_API_KEY=
# SGIS_API_SECRET=

# --- 행정안전부 법정동코드 API — 아직 미연동 (지금은 app/data/lawd_codes.json 고정값 사용) ---
# JUSO_API_KEY=

# --- 카카오맵 API (프론트엔드 js/utils/map-util.js에서 사용) — 아직 미연동 ---
# KAKAO_MAP_APP_KEY=

# --- Pinecone (RAG 파이프라인, 심화 단계) — 아직 미연동 ---
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=
