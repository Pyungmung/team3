# --- Java / Spring Boot (backend) ---
backend/target/
*.class
*.jar
*.log
backend/uploads/

# --- Python (customhouse-ai) ---
customhouse-ai/.venv/
customhouse-ai/**/__pycache__/
*.pyc

# --- Node / Frontend build (future) ---
frontend/node_modules/
frontend/dist/

# --- IDE / OS ---
.idea/
.vscode/
.vs/
*.iml
.DS_Store
Thumbs.db

# --- Secrets (CLAUDE.md 수칙: 키는 .env에만, .env는 절대 커밋 금지) ---
.env
.env.*
!.env.example
!*/.env.example

# 프론트엔드는 빌드 단계가 없는 순수 JS라 .env를 못 씀 -> config.js에 카카오맵 키 등을 둔다.
frontend/src/js/config.js

# --- 더미 매물 생성 작업 폴더(캐시/로그/임시 CSV) ---
customhouse-ai/scripts/_work/

# --- 한국부동산원 전환율 조회 캐시 (customhouse-ai/app/services/reb_conversion_rate.py가 만드는 파일) ---
customhouse-ai/app/data/cache/

# --- 로컬 서버 실행 스크립트(scripts/local-servers.ps1)가 만드는 로그/PID 폴더 ---
logs/
